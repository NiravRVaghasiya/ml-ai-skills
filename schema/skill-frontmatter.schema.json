{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKILL.md frontmatter",
  "description": "GENERATED by scripts/generate_schema.py from schema/allowed_values.py; do not edit by hand. Rules JSON Schema cannot express (future last_verified, reserved words in name, XML tags in description, cross-skill references) are enforced by scripts/validate_skills.py.",
  "type": "object",
  "required": [
    "name",
    "display_name",
    "description",
    "type",
    "domain",
    "level",
    "lifecycle",
    "risk_level",
    "evidence_level",
    "last_verified",
    "capabilities",
    "requires",
    "conflicts",
    "related",
    "inputs",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "type": {
      "type": "string",
      "enum": [
        "workflow",
        "reference"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "foundations",
        "classical-ml",
        "deep-learning",
        "llm",
        "specialized",
        "mlops",
        "responsible-ai",
        "security"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "stable",
        "draft",
        "deprecated"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "primary",
        "official-documentation",
        "established-practice",
        "heuristic",
        "opinion"
      ]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "capabilities": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "requires": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "conflicts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "related": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "string",
      "minLength": 1
    },
    "version_constraints": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
